# ──────────────────────────────────────────────────────────────
# Frontend (set these in Vercel dashboard → Settings → Environment Variables)
# ──────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
VITE_API_URL=https://your-backend.onrender.com

# ──────────────────────────────────────────────────────────────
# Backend (set these in Render dashboard → Environment)
# ──────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
GEMINI_API_KEY=AIza...
AI_MODEL=gemini-2.5-flash
ALLOWED_ORIGIN=https://your-app.vercel.app
PORT=5001

# ──────────────────────────────────────────────────────────────
# Autopilot (optional; defaults shown). Free-tier friendly models.
# ──────────────────────────────────────────────────────────────
AUTOPILOT_MODEL_FAST=gemini-3.1-flash-lite
AUTOPILOT_MODEL_STANDARD=gemini-3.5-flash-lite
AUTOPILOT_MODEL_STANDARD_FALLBACK=gemini-3.1-flash-lite
AUTOPILOT_MODEL_FALLBACK=gemini-3.5-flash-lite
AUTOPILOT_RUN_TOKEN_BUDGET=400000
AUTOPILOT_MAX_CONCURRENT_WORKERS=3

# Email notifications (optional): the run owner is emailed when a request waits on them
# and when a run is delivered. Leave RESEND_API_KEY empty to turn emails off.
# Without a verified domain, Resend only delivers to the Resend account's own address.
RESEND_API_KEY=
AUTOPILOT_EMAIL_FROM=ZeroOne Autopilot <onboarding@resend.dev>
APP_URL=https://your-app.vercel.app
